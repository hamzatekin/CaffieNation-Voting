{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "caffienation-voting",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caffienation-votes",
      "database_id": "b24edb1c-8d63-487b-944e-cec7f8838e0d"
    }
  ],
  // Workers AI, used for the admin page's comment summary (free daily allowance).
  "ai": { "binding": "AI" },
  "vars": {
    // Optional: cap votes per network per machine. 0 = off. Keep it off for
    // office Wi-Fi, where everyone shares one public IP.
    "MAX_VOTES_PER_IP": "0"
  }
}
